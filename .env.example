# Copy to .env and adjust. Never commit .env.
PORT=3000
# Leave MONGO_URI empty to use an in-memory MongoDB (seeded automatically).
MONGO_URI=
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
ATTENDANCE_THRESHOLD=75
SEED_ON_START=true

# Time zone used for "today" when validating dates (see docs/risks.md R3).
TZ=Asia/Kolkata
# Failed logins allowed per (IP, email) in 15 minutes before 429.
LOGIN_MAX_FAILURES=10
