{
  "info": {
    "name": "Student Attendance Tracker API",
    "description": "SAT-8 automated API suite. Covers login ok/fail, RBAC 403s, mark 201, duplicate 409, data isolation, summaries, filters and validation. Every request also checks JSON content type and response time (collection-level test).",
