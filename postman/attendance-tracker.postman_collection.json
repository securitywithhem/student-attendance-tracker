            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{faculty1Token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{markBody}}"
            },
            "url": "{{baseUrl}}/api/courses/{{cse706Id}}/attendance"
          }
        },
        {
          "name": "Session read-back shows the saved register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('marked with 10 records, unchanged by the 409', () => { const b = pm.response.json(); pm.expect(b.marked).to.eql(true); pm.expect(b.records.filter(r => r.status === 'absent')).to.have.length(1); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{faculty1Token}}"
              }
            ],
            "url": "{{baseUrl}}/api/courses/{{cse706Id}}/attendance?date={{markDate}}"
          }
        },
        {
          "name": "RBAC — student marks attendance → 403",
          "event": [
